# API Server
PORT=3001
NODE_ENV=development

# ============================================
# LLM Configuration (Multiple Providers)
# ============================================
# Supported providers: groq, openrouter, together, openai, ollama, custom
LLM_PROVIDER=groq

# API Key (required for cloud providers, not needed for ollama)
LLM_API_KEY=your_api_key_here

# Optional: Override base URL (auto-set based on provider)
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Optional: Override model (auto-set based on provider)
# LLM_MODEL=llama-3.3-70b-versatile

LLM_TIMEOUT=30000

# Set to 'true' to use mock responses without any LLM
LLM_MOCK_MODE=false

# ============================================
# Provider Quick Setup (choose one)
# ============================================

# --- GROQ (Recommended - Free) ---
# Get key: https://console.groq.com (no credit card)
# 14,400 requests/day free
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_xxxxx
# Models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768

# --- OPENROUTER (Free models available) ---
# Get key: https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-xxxxx
# Models: meta-llama/llama-3.1-8b-instruct:free, google/gemma-2-9b-it:free

# --- TOGETHER AI ($25 free credits) ---
# Get key: https://api.together.xyz
# LLM_PROVIDER=together
# LLM_API_KEY=xxxxx
# Models: meta-llama/Llama-3.3-70B-Instruct-Turbo, mistralai/Mixtral-8x7B-Instruct-v0.1

# --- OPENAI (Paid) ---
# Get key: https://platform.openai.com/api-keys
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxxxx
# Models: gpt-4o-mini, gpt-4o, gpt-3.5-turbo

# --- OLLAMA (Local - Free) ---
# Install: https://ollama.ai
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3
# (No API key needed)

# --- CUSTOM (Any OpenAI-compatible API) ---
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-api.com/v1
# LLM_API_KEY=your_key
# LLM_MODEL=your_model

# ============================================
# Sports Data APIs
# ============================================

# TheSportsDB API (Free tier key is "3")
SPORTSDB_API_KEY=3

# Cricket API (CricAPI.com)
# Get free key: https://www.cricapi.com/ (100 requests/day free)
# Required for live cricket scores
CRICKET_API_KEY=your_cricket_api_key_here

# Cache settings (seconds)
CACHE_TTL=300
CACHE_CHECK_PERIOD=60

# Rate limiting
RATE_LIMIT_MAX=30

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend (apps/web/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:3001
